{
  "version": 1,
  "_comment": "Equicord/Vencord catalog audit for Exocord first-party tools. Verdict: absorb | rewrite | skip. Default-on pack prioritized first.",
  "tools": {
    "fakeNitro": { "verdict": "rewrite", "tier": "default", "source": "FakeNitro", "file": "fake-nitro.js" },
    "limitlessScreenshare": { "verdict": "rewrite", "tier": "default", "source": "LimitlessScreenshare", "file": "limitless-screenshare.js" },
    "searchFix": { "verdict": "absorb", "tier": "default", "source": "SearchFix", "file": "search-fix.js" },
    "volumeBooster": { "verdict": "absorb", "tier": "default", "source": "VolumeBooster", "file": "volume-booster.js" },
    "messageLogger": { "verdict": "rewrite", "tier": "default", "source": "MessageLogger", "note": "append-only + age-fade", "file": "message-logger.js" },
    "noNitroUpsell": { "verdict": "absorb", "tier": "default", "source": "NoNitroUpsell", "file": "no-nitro-upsell.js" },
    "alwaysTrust": { "verdict": "absorb", "tier": "default", "source": "AlwaysTrust", "file": "always-trust.js" },
    "validReply": { "verdict": "absorb", "tier": "default", "source": "ValidReply", "file": "valid-reply.js" },
    "ignoreActivities": { "verdict": "absorb", "tier": "default", "source": "IgnoreActivities", "file": "ignore-activities.js" },
    "noPendingCount": { "verdict": "absorb", "tier": "default", "source": "NoPendingCount", "file": "no-pending-count.js" },
    "noProfileThemes": { "verdict": "absorb", "tier": "default", "source": "NoProfileThemes", "file": "no-profile-themes.js" },
    "noSystemBadge": { "verdict": "absorb", "tier": "default", "source": "NoSystemBadge", "file": "no-system-badge.js" },
    "noTypingAnimation": { "verdict": "absorb", "tier": "default", "source": "NoTypingAnimation", "file": "no-typing-animation.js" },
    "hideChatButtons": { "verdict": "absorb", "tier": "default", "source": "HideChatButtons", "file": "hide-chat-buttons.js" },
    "notificationVolume": { "verdict": "rewrite", "tier": "default", "source": "NotificationVolume", "note": "complements quietSounds", "file": "notification-volume.js" },
    "quickReply": { "verdict": "absorb", "tier": "default", "source": "QuickReply", "file": "quick-reply.js" },
    "noReplyMention": { "verdict": "absorb", "tier": "default", "source": "NoReplyMention", "file": "no-reply-mention.js" },
    "characterCounter": { "verdict": "absorb", "tier": "default", "source": "CharacterCounter", "file": "character-counter.js" },
    "keepCurrentChannel": { "verdict": "absorb", "tier": "default", "source": "KeepCurrentChannel", "file": "keep-current-channel.js" },
    "stopAutoUnread": { "verdict": "absorb", "tier": "default", "source": "StopAutoUnread", "file": "stop-auto-unread.js" },
    "disableCallIdle": { "verdict": "rewrite", "tier": "default", "source": "DisableCallIdle", "note": "tool wrapper for Exocore noCallIdle", "file": "disable-call-idle.js" },
    "gameActivityToggle": { "verdict": "rewrite", "tier": "default", "source": "GameActivityToggle", "file": "game-activity-toggle.js" },
    "memberCount": { "verdict": "absorb", "tier": "default", "source": "MemberCount", "file": "member-count.js" },
    "readAllNotifications": { "verdict": "rewrite", "tier": "default", "source": "ReadAllNotifications", "file": "read-all-notifications.js" },
    "crashHandler": { "verdict": "rewrite", "tier": "default", "source": "CrashHandler", "note": "local log, no Sentry leak", "file": "crash-handler.js" },
    "imageZoom": { "verdict": "absorb", "tier": "default", "source": "ImageZoom", "file": "image-zoom.js" },
    "viewIcons": { "verdict": "absorb", "tier": "default", "source": "ViewIcons", "file": "view-icons.js" },
    "anonymiseFileNames": { "verdict": "rewrite", "tier": "default", "source": "AnonymiseFileNames", "file": "anonymise-file-names.js" }
  },
  "exocoreFeaturesCoveringLean": [
    "analyticsOff",
    "metricsOff",
    "sentryOff",
    "cleanTrackingLinks",
    "silentTyping",
    "noCallIdle",
    "quietSounds",
    "onePingPerDM",
    "consoleJanitor",
    "noF1",
    "reducedMotion",
    "leanAccessibility",
    "overlayOff"
  ],
  "skipClasses": [
    "SupportHelper",
    "EquicordHelper",
    "NewPluginsManager",
    "ThemeLibrary",
    "platform spoofers",
    "invisible chat as default-on"
  ]
}
